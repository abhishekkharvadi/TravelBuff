{
  "name": "travelbuff",
  "version": "7.7.4",
  "description": "Self-hosted travel log, planning and trip app",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "audit": "osv-scanner scan source -L package-lock.json",
    "postinstall": "node -e \"try{require.resolve('vite'); require('child_process').execSync('npm run build',{stdio:'inherit'})}catch(e){}\"",
    "start": "cross-env PORT=3000 node server.js",
    "server": "nodemon --use-system-ca server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "concurrently \"cross-env PORT=3001 npm run server\" \"npm run client\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "mammoth": "^1.12.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdf2md": "^1.0.2",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^5.1.0",
    "turndown": "^7.2.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.2",
    "vite": "^7.3.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@rollup/rollup-linux-arm64-gnu": "4.63.1",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-linux-arm64-musl": "4.63.1",
    "@rollup/rollup-linux-x64-musl": "4.63.1"
  },
  "overrides": {
    "qs": "^6.15.4",
    "axios": "^1.20.0",
    "brace-expansion": "^2.1.7",
    "multer": "^2.4.0",
    "busboy": "^1.6.0",
    "undici": "^6.28.1"
  }
}
